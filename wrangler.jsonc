{
  "name": "minecraft-world",
  "compatibility_date": "2026-10-27",
  // Trigger a fresh GitHub-connected Cloudflare build after build-token rotation.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minecraft-world-db",
      "database_id": "3b10091e-efc0-4e8c-9195-8514a7b0aded"
    }
  ],
  "main": "src/worker.js"
}
